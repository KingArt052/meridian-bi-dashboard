# Server
PORT=4000
NODE_ENV=development

# Claude API (used server-side only — never exposed to frontend/n8n)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-6

# Database
# In production, swap the SQLite adapter (src/db/index.ts) for a Postgres
# connection string like the one below (Supabase/Render/RDS all provide one).
DATABASE_URL=postgresql://user:password@host:5432/bi_dashboard
SQLITE_PATH=./data/bi_dashboard.db

# n8n / alerting
ALERT_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/bi-alerts
INGEST_API_KEY=change-me-shared-secret-for-n8n-to-call-ingest
